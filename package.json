{
  "name": "keep-sorted",
  "private": true,
  "displayName": "Keep Sorted",
  "description": "VS Code extension to automatically keep code blocks sorted",
  "version": "1.0.2",
  "icon": "images/logo.png",
  "galleryBanner": {
    "color": "#134e4a",
    "theme": "dark"
  },
  "publisher": "awalsh128",
  "author": {
    "name": "awalsh128"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/awalsh128/vscode-keep-sorted#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/awalsh128/vscode-keep-sorted"
  },
  "bugs": {
    "url": "https://github.com/awalsh128/vscode-keep-sorted/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "proseWrap": "always",
    "plugins": [
      "prettier-plugin-jsdoc"
    ],
    "jsdocPreferCodeFences": true,
    "jsdocSeparateReturnsFromParam": true,
    "jsdocSeparateTagGroups": true
  },
  "keywords": [
    "sort",
    "lines",
    "organize",
    "format",
    "code",
    "auto-sort",
    "keep-sorted",
    "language-agnostic"
  ],
  "categories": [
    "Formatters",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "keep-sorted.fixFile",
        "title": "Keep Sorted: Sort Current File"
      },
      {
        "command": "keep-sorted.fixWorkspace",
        "title": "Keep Sorted: Sort All Files with Problems"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "keep-sorted.fixFile",
          "when": "config.keep-sorted.enabled"
        },
        {
          "command": "keep-sorted.fixWorkspace",
          "when": "config.keep-sorted.enabled"
        }
      ]
    },
    "configuration": {
      "title": "Keep Sorted",
      "properties": {
        "keep-sorted.enabled": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "Enable Keep Sorted diagnostics, sorting commands, and code actions. To sort on save, configure `#editor.codeActionsOnSave#` with `\"source.fixAll.keepSorted\": \"explicit\"` (manual saves) or `\"always\"` (also focus/window-change Auto Save, not after-delay Auto Save). `#editor.formatOnSave#` alone does not enable sorting."
        },
        "keep-sorted.autoComplete": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "markdownDescription": "Suggest keep-sorted option names and values, with documentation tooltips, after `start` on a `keep-sorted start` line."
        },
        "keep-sorted.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 3,
          "markdownDescription": "Exclude files from diagnostics and sorting. Patterns are interpreted as regular expressions first, with glob matching used when a pattern is not a valid regex. Each pattern is checked against the workspace-relative path, absolute path, and file name.",
          "examples": [
            [
              "**/node_modules/**",
              "**/dist/**",
              "^tests/[^1-9]\\w+.*\\.js"
            ]
          ]
        },
        "keep-sorted.logFilepath": {
          "type": "string",
          "default": "",
          "order": 4,
          "markdownDescription": "Write extension logs to a file in addition to the Keep Sorted Output channel. Empty disables file logging. Paths are joined to the first workspace folder when one is open; without a workspace, the configured path is used directly. Use a workspace-relative path such as `logs/keep-sorted.log`.",
          "examples": [
            "",
            "keep-sorted.log",
            "logs/keep-sorted.log"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm ci && npm run compile",
    "compile": "npm run clean && tsc -b --clean && tsc -b",
    "lint": "eslint",
    "ops": "tsx scripts/ops.ts",
    "watch": "tsc -b -w",
    "dev": "npm run compile && tsx scripts/dev.ts",
    "test": "npm run compile && rimraf ./src/test/logs/ && node ./out/test/runTest.js",
    "test:runner": "npm run compile && node ./out/test/runTest.js",
    "test:scripts": "npm run compile && mocha out/scripts/test/**/*.test.js",
    "create-binaries": "tsx scripts/create-binaries.ts",
    "clean": "rimraf out/",
    "refreshlock": "npm i --package-lock-only",
    "sync-labels": "tsx scripts/sync-labels.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@octokit/rest": "^22.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/logform": "^1.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.11",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "@types/source-map-support": "^0.5.10",
    "@types/triple-beam": "^1.3.5",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "azure-devops-node-api": "12.5.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.0.1",
    "eslint-plugin-mocha": "^11.2.0",
    "js-yaml": "^5.4.3",
    "logform": "^2.7.0",
    "mocha": "^11.7.5",
    "mocha-explorer-launcher-scripts": "^0.4.0",
    "prettier-plugin-jsdoc": "^1.3.3",
    "rimraf": "^6.1.0",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "glob-regex": "^0.3.2",
    "triple-beam": "^1.4.1",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "overrides": {
    "diff": "^8.0.3",
    "esbuild": ">=0.28.2",
    "minimatch": ">=10.2.1",
    "serialize-javascript": ">=7.0.5"
  }
}
