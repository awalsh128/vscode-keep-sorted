{
  "name": "keep-sorted",
  "private": true,
  "displayName": "Keep Sorted",
  "description": "VS Code extension to automatically keep code blocks sorted",
  "version": "0.0.1",
  "icon": "logo.png",
  "publisher": "awalsh128",
  "author": {
    "name": "awalsh128"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/awalsh128/vscode-keep-sorted#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/awalsh128/vscode-keep-sorted"
  },
  "bugs": {
    "url": "https://github.com/awalsh128/vscode-keep-sorted/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "keywords": [
    "sort",
    "lines",
    "organize",
    "format",
    "code",
    "auto-sort",
    "keep-sorted",
    "language-agnostic"
  ],
  "categories": [
    "Formatters",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "keep-sorted.sortFile",
        "title": "Keep Sorted: Sort Current File"
      }
    ],
    "configuration": {
      "title": "Keep Sorted",
      "properties": {
        "keep-sorted.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the keep-sorted extension"
        },
        "keep-sorted.autoComplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable autocomplete suggestions for keep-sorted options when typing after the 'start' keyword."
        },
        "keep-sorted.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Array of glob or regex patterns to exclude files from being processed by the extension (relative to the workspace root).",
          "examples": [
            [
              "**/node_modules/**",
              "**/dist/**",
              "^tests/[^1-9]\\w+.*\\.js"
            ]
          ]
        },
        "keep-sorted.logFilepath": {
          "type": "string",
          "default": "",
          "description": "File path for logging output. If specified, logs will be written to the specified location. If empty or undefined, file logging is disabled. If a relative path is provided, it will be resolved relative to the workspace root.",
          "examples": [
            "",
            "keep-sorted.log",
            "/var/log/keep-sorted.log"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm ci && npm run compile",
    "compile": "npm run clean && tsc -b --clean && tsc -b",
    "lint": "eslint",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && rimraf ./src/test/logs/ && node ./out/test/runTest.js",
    "test:runner": "npm run compile && node ./out/test/runTest.js",
    "create-binaries": "tsx scripts/create-binaries.ts",
    "clean": "rimraf out/",
    "refreshlock": "npm i --package-lock-only"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@octokit/rest": "^22.0.1",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/logform": "^1.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/sinon": "^17.0.4",
    "@types/sinon-chai": "^4.0.0",
    "@types/source-map-support": "^0.5.10",
    "@types/triple-beam": "^1.3.5",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "chai": "^6.2.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.13.0",
    "eslint-plugin-mocha": "^11.2.0",
    "logform": "^2.7.0",
    "mocha": "^11.3.0",
    "mocha-explorer-launcher-scripts": "^0.4.0",
    "prettier-plugin-jsdoc": "^1.3.3",
    "rimraf": "^6.1.0",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "source-map-support": "^0.5.21",
    "triple-beam": "^1.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "winston": "^3.18.3"
  },
  "dependencies": {
    "glob-regex": "^0.3.2",
    "js-yaml": "^4.1.0",
    "lru-cache": "^11.2.2"
  }
}
