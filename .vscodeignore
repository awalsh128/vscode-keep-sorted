# esbuild bundles the extension and its runtime dependencies into dist/extension.js, so neither
# node_modules/ nor the tsc output in out/ ships.
node_modules/
out/
dist/**/*.map
.vscode-test/
.vscode-test-user-data/
.vscode-test-web/
.vscode-test.mjs
coverage/
src/
scripts/
test-workspace/
